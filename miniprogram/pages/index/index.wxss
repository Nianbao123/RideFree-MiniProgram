/**pages/index/index.wxss**/
page {
  background-color: #f7f8fa;
}

.page {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部标题 */
.header {
  flex-shrink: 0;
  padding: 32rpx 32rpx 20rpx;
  background-color: #e8f5e9;
}

.header_title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

.header_sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7d6c;
}

/* 地图 */
.map_wrap {
  flex-shrink: 0;
  position: relative;
  width: 100%;
  height: 34vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.map {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.map_stat {
  position: absolute;
  left: 44rpx;
  top: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.map_stat_num {
  font-size: 30rpx;
  font-weight: 600;
  color: #4caf50;
}

.map_stat_unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #666666;
}

/* 车辆列表 */
.list {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  overflow: hidden;
}

.list_title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.card {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card_icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background-color: #e8f5e9;
  color: #4caf50;
  font-size: 32rpx;
  line-height: 76rpx;
  text-align: center;
}

.card_body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.card_id {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card_type {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card_btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 30rpx;
  background-color: #e8f5e9;
  color: #4caf50;
  font-size: 26rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b6b6b6;
}

/* 进行中的订单 */
.current {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background-color: #e8f5e9;
}

.current_title {
  font-size: 28rpx;
  font-weight: 500;
  color: #4caf50;
}

.current_info {
  margin: 10rpx 0 20rpx;
  font-size: 26rpx;
  color: #666666;
}

.current_btn {
  display: inline-block;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  background-color: #4caf50;
  color: #ffffff;
  font-size: 26rpx;
}

.placeholder {
  height: 220rpx;
}

/* 底部固定操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
}

.btn_primary {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background-color: #4caf50;
  border-radius: 44rpx;
}

.btn_primary::after {
  border: none;
}

.btn_primary_hover {
  background-color: #43a047;
}

.btn_ghost {
  flex: 1;
  margin: 0 0 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #4caf50;
  background-color: transparent;
  border: 2rpx solid #4caf50;
  border-radius: 44rpx;
}

.btn_ghost::after {
  border: none;
}

.btn_ghost_hover {
  background-color: #e8f5e9;
}
